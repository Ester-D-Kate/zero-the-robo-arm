# Webpage layout only. Rebuild the webpage after changing this flag.
HAS_ROBOTIC_ARM=false
# Unlocks the admin signing key in the browser. Never upload .env.
ADMIN_PASSWORD=replace-with-a-long-unique-password
# Browser queue coordination only; firmware command topics remain unchanged.
MQTT_TOPIC_PREFIX=zero/your-unique-web-queue-id
MQTT_WEBSOCKET_URL=wss://broker.emqx.io:8084/mqtt
# Optional broker credentials are included in the browser build.
MQTT_USERNAME=
MQTT_PASSWORD=
QUEUE_MODE=automatic
# Must match the existing voice/security server. This legacy token is public in the webpage.
VOICE_SECURITY_TOKEN=ALICE_ZERO_2024_SECURE
